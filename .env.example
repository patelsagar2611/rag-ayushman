# Copy to .env (which is gitignored) and fill in. Never commit a real key.
#
# Which backend generates answers: "ollama" (local, the baseline) or "openai"
# (any OpenAI-compatible chat endpoint). Ollama is the default; a hosted model is
# a DIFFERENT model, so switching this changes what the numbers mean.
LLM_PROVIDER=ollama

# --- openai-compatible provider (only read when LLM_PROVIDER=openai) ---
# Groq by default. OpenRouter, Together and a local vLLM all speak the same API;
# point OPENAI_BASE_URL at them instead.
GROQ_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Must be a model that does NOT emit inline <think> blocks -- see the guard in
# src/generate.call_openai_compatible.
OPENAI_MODEL=openai/gpt-oss-120b

# --- local ollama (only read when LLM_PROVIDER=ollama) ---
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b
