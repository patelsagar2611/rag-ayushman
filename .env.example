# Copy to .env (which is gitignored) and fill in. Never commit a real key.

# --- which backend answers ---------------------------------------------------
#
# THESE TWO WORK TOGETHER. Read both before setting either.
#
# LLM_PROVIDER is the API SHAPE:
#     ollama  -> the local baseline. Its own request format, and the only backend
#                that reports a true prefill/decode split.
#     openai  -> any OpenAI-compatible chat endpoint.
#
# LLM_BACKEND is WHICH openai-compatible endpoint, and is READ ONLY WHEN
# LLM_PROVIDER=openai. Setting it while LLM_PROVIDER=ollama is not an error -- it
# is how you flip to the local model without disturbing your hosted config -- but
# the backend is then ignored, so a pair like `ollama` + `google` does nothing you
# might expect.
#
# The settings below are grouped by backend, so the URL, key, model and upstream
# pin are selected TOGETHER by one name and cannot be left half-switched. Adding a
# vendor is three lines here and NO code change: define <NAME>_BASE_URL,
# <NAME>_API_KEY and <NAME>_MODEL, then point LLM_BACKEND at it.
#
# As shipped: the hosted deployment path. Change LLM_PROVIDER to `ollama` for the
# local baseline; LLM_BACKEND can stay as it is.
LLM_PROVIDER=openai
LLM_BACKEND=google


# --- google ai studio, direct ------------------------------------------------
# The deployment backend: free tier, and its runs are byte-identical to
# OpenRouter runs pinned to "Google AI Studio", so the free path inherits the
# numbers that were actually measured. A direct endpoint is its own provider, so
# GOOGLE_PROVIDER would be meaningless and is not set.
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_MODEL=models/gemini-3.1-flash-lite


# --- openrouter --------------------------------------------------------------
# The fallback, and the only path that can PIN an upstream deployment. Costs
# credit; Google direct does not. Note the model id differs from Google's for the
# same underlying model -- which is exactly why these are grouped per backend
# rather than left as free-standing settings.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.1-flash-lite-20260507
# An aggregator serves one model id from several deployments and picks per
# request, so an unpinned run is BLENDED and its numbers are not reproducible
# (gotcha 20). Recording what served is mandatory; pinning is optional.
OPENROUTER_PROVIDER=Google AI Studio


# --- groq --------------------------------------------------------------------
# Models must NOT emit inline <think> blocks -- see the guard in
# src/generate.call_openai_compatible.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b


# --- local ollama (only read when LLM_PROVIDER=ollama) -----------------------
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=qwen2.5:7b
